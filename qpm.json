{
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "version": "0.1.0",
  "info": {
    "name": "Halloween",
    "id": "halloween",
    "version": "1.1.0",
    "url": null,
    "additionalData": {
      "overrideSoName": "libhalloween.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "pwsh ./scripts/build.ps1"
      ],
      "clean": [
        "pwsh ./scripts/build.ps1 -clean"
      ],
      "copy": [
        "pwsh ./scripts/copy.ps1 $0:?"
      ],
      "logcat": [
        "pwsh ./scripts/start-logging.ps1"
      ],
      "qmod": [
        "pwsh ./scripts/build.ps1",
        "pwsh ./scripts/createqmod.ps1"
      ],
      "restart": [
        "pwsh ./scripts/restart-game.ps1"
      ],
      "stack": [
        "pwsh ./scripts/ndk-stack.ps1"
      ],
      "tomb": [
        "pwsh ./scripts/pull-tombstone.ps1"
      ]
    },
    "ndk": "^29.0.14206865",
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs",
      "./FileCopies"
    ],
    "qmodOutput": "./Halloween.qmod"
  },
  "dependencies": [
    {
      "id": "config-utils",
      "versionRange": "^2.0.3",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.7",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.8.0",
      "additionalData": {}
    },
    {
      "id": "beatsaber-hook",
      "versionRange": "^9.3.0",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.6.5",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.21.2",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "^4503.0.0",
      "additionalData": {}
    }
  ]
}
